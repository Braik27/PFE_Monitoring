# ══════════════════════════════════════════════════════════════
# Flux Monitor — example environment file
# Copy to backend/.env (backend + scheduler containers) and mirror
# the MYSQL_* / GUNICORN_* values in the repo-root .env used by
# docker compose interpolation. NEVER commit real .env files.
# ══════════════════════════════════════════════════════════════

# ── Flask ──
FLASK_ENV=production
SECRET_KEY=change-me-64-random-hex-chars
APP_BASE_URL=http://localhost:8080

# ── Storage backend (local | azure) ──
STORAGE_BACKEND=local
LOCAL_DB_PATH=/app/instance/flux.db

# MySQL (compose overrides host to `mysql`; keep creds identical)
MYSQL_URL=mysql+pymysql://flux:fluxpass-dev-only@127.0.0.1:3306/flux_monitor?charset=utf8mb4

# Root .env only — consumed by docker compose:
# MYSQL_ROOT_PASSWORD=rootpw-dev-only
# MYSQL_USER=flux
# MYSQL_PASSWORD=fluxpass-dev-only
# MYSQL_DB=flux_monitor

# ── Bootstrap admin (seeded on first run) ──
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password

# ── Scheduler orchestration ──
# scheduler container runs the jobs; web tier must NOT duplicate them
ENABLE_SCHEDULER=true
FLASK_EMBEDDED_SCHEDULER=0
QUEUE_BACKEND=local

# ── Gunicorn (Dockerfile CMD knobs) ──
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=300

# ── Alerts ──
WATCHER_ENABLED=false
ALERT_EMAIL_ENABLED=false
ALERT_PROVIDER=smtp            # smtp | sendgrid
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=ops@example.com
ALERT_EMAIL_FROM=flux@example.com

# ── AI / LLM ──
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ── Azure Storage (STORAGE_BACKEND=azure only) ──
AZURE_STORAGE_CONNECTION_STRING=
AZURE_QUEUE_NAME=flux-jobs
